            "buy_buttons": {
              "type": "buy-buttons",
              "settings": {
                "show_pickup_availability": false
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button primary"
                  }
                }
              }
            },
            "guarantee_badges": {
              "type": "text",
              "settings": {
                "text": "<div style='display:flex; gap:10px; font-size:0.8rem;'><p>✅ Satisfait ou Remboursé (30j)</p><p>🚚 Livraison Gratuite</p><p>🛡️ Garantie 2 ans</p></div>",
                "type_preset": "caption"
              }
            },
            "description_block": {
              "type": "text",
              "settings": {
                "text": "{{ closest.product.description }}",
                "type_preset": "rte"
              }
            }
          },
          "block_order": [
            "title_block",
            "price_block",
            "variant_picker",
            "buy_buttons",
            "guarantee_badges",
            "description_block"
          ]
