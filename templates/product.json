                  }
                },
                "rating": {
                  "type": "text",
                  "settings": {
                    "text": "★★★★★ 4.9/5 (15,000+ utilisateurs ravis)",
                    "type_preset": "caption"
                  }
                }
              }
            },
            "price_block": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "font_size": "1.5rem"
              }
            },
            "variant_picker": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons"
              }
