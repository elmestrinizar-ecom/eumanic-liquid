{
  "sections": {
    "hero_section": {
      "type": "hero",
      "blocks": {
        "hero_content": {
          "type": "group",
          "name": "Contenu Hero",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment": "center",
            "vertical_alignment": "center",
            "gap": 24,
            "width": "fit-content",
            "padding-block-start": 40,
            "padding-block-end": 40
          },
          "blocks": {
            "hero_title": {
              "type": "text",
              "settings": {
                "text": "<h1>Adieu Cernes & Poches. <br>Définitivement.</h1>",
                "type_preset": "h1",
                "color": "#000000"
              }
            },
            "hero_subtitle": {
              "type": "text",
              "settings": {
                "text": "<p style='font-size: 1.2rem;'>Obtenez un regard rajeuni en 10 minutes par jour grâce à la combinaison cliniquement prouvée de Lumière Rouge + EMS.</p>",
                "max_width": "narrow"
              }
            },
            "hero_cta": {
              "type": "button",
              "settings": {
                "label": "PROFITER DE L'OFFRE -50%",
                "link": "shopify://products/eyeluxe-pro",
                "style_class": "button primary",
                "width": "fit-content"
              }
            }
          },
          "block_order": [
            "hero_title",
            "hero_subtitle",
            "hero_cta"
          ]
        }
      },
      "settings": {
        "media_type_1": "image",
        "image_1": "shopify://shop_images/eumanic_before_after_1.png",
        "section_height": "large"
      }
    },
    "featured_product": {
      "type": "boku-info",
      "blocks": {
        "product-details": {
          "type": "boku-details",
          "blocks": {
            "title": {
              "type": "product-title",
              "settings": {
                "type_preset": "h2"
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "type_preset": "h4"
              }
            },
            "variant-picker": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "swatch"
              }
            },
            "buy-buttons": {
              "type": "buy-buttons",
              "settings": {}
            }
          },
          "block_order": [
            "title",
            "price",
            "variant-picker",
            "buy-buttons"
          ]
        }
      },
      "block_order": [
        "product-details"
      ],
      "settings": {
        "product": "eyeluxe-pro",
        "desktop_media_position": "left"
      }
    }
  },
  "order": [
    "hero_section",
    "featured_product"
  ]
}