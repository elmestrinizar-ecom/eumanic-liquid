{
  "sections": {
    "hero_section": {
      "type": "hero",
      "blocks": {
        "hero_content": {
          "type": "group",
          "name": "Contenu Hero",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment": "center",
            "vertical_alignment": "center",
            "gap": 16,
            "width": "fit-content",
            "padding-block-start": 40,
            "padding-block-end": 40
          },
          "blocks": {
            "hero_trust": {
              "type": "text",
              "settings": {
                "text": "<p style='color: #E63946; font-weight: 700; font-size: 0.9rem; margin-bottom: -10px;'>★★★★★ 600,000+ CLIENTS SATISFAITS</p>",
                "alignment": "center"
              }
            },
            "hero_title": {
              "type": "text",
              "settings": {
                "text": "<h1 style='font-size: 3.5rem; line-height: 1.1;'>Régénérez votre regard en 10 minutes.</h1>",
                "type_preset": "h1",
                "color": "#000000"
              }
            },
            "hero_subtitle": {
              "type": "text",
              "settings": {
                "text": "<p style='font-size: 1.2rem; color: #444;'>La seule technologie de photothérapie LED cliniquement prouvée pour éliminer cernes et poches, à domicile.</p>",
                "max_width": "narrow"
              }
            },
            "hero_cta": {
              "type": "button",
              "settings": {
                "label": "DÉCOUVRIR EYELUXE PRO",
                "link": "shopify://products/eyeluxe-pro",
                "style_class": "button primary",
                "width": "fit-content"
              }
            }
          },
          "block_order": [
            "hero_trust",
            "hero_title",
            "hero_subtitle",
            "hero_cta"
          ]
        }
      },
      "settings": {
        "media_type_1": "image",
        "image_1": "https://cdn.shopify.com/s/files/1/0986/3141/8238/files/Un_regard_repose_en_10_minutes.png?v=1770486587",
        "section_height": "large",
        "desktop_content_position": "middle-center",
        "show_text_overlay": true
      }
    },
    "featured_product": {
      "type": "boku-info",
      "blocks": {
        "product-details": {
          "type": "boku-details",
          "blocks": {
            "title": {
              "type": "product-title",
              "settings": {
                "type_preset": "h2"
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "type_preset": "h4"
              }
            },
            "variant-picker": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "swatch"
              }
            },
            "buy-buttons": {
              "type": "buy-buttons",
              "settings": {}
            }
          },
          "block_order": [
            "title",
            "price",
            "variant-picker",
            "buy-buttons"
          ]
        }
      },
      "block_order": [
        "product-details"
      ],
      "settings": {
        "product": "eyeluxe-pro",
        "desktop_media_position": "left"
      }
    }
  },
  "order": [
    "hero_section",
    "featured_product"
  ]
}