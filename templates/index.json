        "hero_content": {
          "type": "group",
          "name": "Contenu Hero",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment": "center",
            "vertical_alignment": "center",
            "gap": 24,
            "width": "fit-content",
            "padding-block-start": 40,
            "padding-block-end": 40
          },
          "blocks": {
            "hero_title": {
              "type": "text",
              "settings": {
                "text": "<h1>Adieu Cernes & Poches. <br>Définitivement.</h1>",
                "type_preset": "h1",
                "color": "#000000"
              }
            },
            "hero_subtitle": {
              "type": "text",
              "settings": {
                "text": "<p style='font-size: 1.2rem;'>Obtenez un regard rajeuni en 10 minutes par jour grâce à la combinaison cliniquement prouvée de Lumière Rouge + EMS.</p>",
                "max_width": "narrow"
              }
            },
            "hero_cta": {
              "type": "button",
              "settings": {
                "label": "PROFITER DE L'OFFRE -50%",
                "link": "shopify://products/eumanic-pro",
                "style_class": "button primary",
                "width": "fit-content"
              }
            },
            "hero_guarantee": {
              "type": "text",
              "settings": {
                "text": "<p style='font-size: 0.9rem; color: #555;'>✅ 30 Jours d'Essai - Satisfait ou Remboursé</p>"
