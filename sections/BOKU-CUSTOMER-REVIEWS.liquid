<style>
  .botanique-reviews-section {
    padding: 60px 0;
    background-color: #ffffff;
    font-family: 'Inter', sans-serif;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
  }

  .botanique-reviews__container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
  }

  .botanique-reviews__track-container {
    overflow: hidden;
    width: 100%;
  }

  .botanique-reviews__track {
    display: flex;
    transition: transform 0.5s ease-in-out;
    width: 100%;
  }

  .botanique-review__slide {
    min-width: 100%;
    flex-shrink: 0;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px 0;
  }

  .botanique-review__content {
    display: flex;
    align-items: center;
    max-width: 90%;
    gap: 40px;
  }

  @media (max-width: 768px) {
    .botanique-review__content {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }
  }

  .botanique-review__image-wrapper {
    flex-shrink: 0;
  }

  .botanique-review__image {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #fff;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .botanique-review__text-wrapper {
    flex: 1;
  }

  .botanique-review__quote {
    font-size: 1.25rem;
    line-height: 1.5;
    color: #333;
    font-style: italic; /* Botanique style */
    margin: 0 0 15px 0;
  }

  @media (max-width: 768px) {
    .botanique-review__quote {
      font-size: 1.1rem;
    }
  }

  .botanique-review__author {
    font-weight: 700;
    font-size: 1rem;
    color: #000;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  @media (max-width: 768px) {
    .botanique-review__author {
      justify-content: center;
      flex-direction: column;
      gap: 5px;
    }
  }

  .verified-badge {
    color: #00C853; /* Green for verified */
    font-weight: 600;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Dots Navigation */
  .botanique-reviews__dots {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }

  .botanique-reviews__dots .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: #E0E0E0; /* Light grey inactive */
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .botanique-reviews__dots .dot.active {
    background-color: #000; /* Active dot color (Botanique has black active) */
  }
  
  /* Brand color adaptation: User said "couleurs doivent rimer avec mon site" -> Eumanic has Red #E63946 */
  /* If user wants dots to be red: */
  .botanique-reviews__dots .dot.active {
    background-color: #E63946; 
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('reviewsTrack-{{ section.id }}');
    const dots = document.querySelectorAll('#reviewsDots-{{ section.id }} .dot');
    let currentIndex = 0;
    const slideCount = dots.length;

    // Function to update slider
    function updateSlider(index) {
      const percentage = index * -100;
      track.style.transform = `translateX(${percentage}%)`;
      
      // Update dots
      dots.forEach(dot => dot.classList.remove('active'));
      dots[index].classList.add('active');
      
      currentIndex = index;
    }

    // Click events for dots
    dots.forEach(dot => {
      dot.addEventListener('click', function() {
        const index = parseInt(this.getAttribute('data-index'));
        updateSlider(index);
      });
    });

    // Optional: Auto-play
    // setInterval(() => {
    //   let nextIndex = (currentIndex + 1) % slideCount;
    //   updateSlider(nextIndex);
    // }, 5000); 
    // Botanique is usually manual? Left manual for now as it's cleaner UX for reading testimonials.
  });
</script>

