{% liquid
  assign product = all_products['eyeluxe-pro'] | default: product
%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');

  .boku-wrapper {
    font-family: 'Inter', sans-serif;
    color: #1a1a1a;
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
    background: #fff;
  }

  .boku-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  @media (max-width: 768px) {
    .boku-grid { grid-template-columns: 1fr; gap: 30px; }
    .boku-wrapper { padding: 30px 15px; }
  }

  .boku-media img {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: transform 0.3s ease;
  }

  .boku-media img:hover {
    transform: scale(1.02);
  }

  .boku-info {
    position: sticky;
    top: 40px;
  }

  .boku-tagline {
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #d0021b; /* Medical Red */
    margin-bottom: 10px;
    display: block;
  }

  .boku-title {
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 15px;
    color: #000;
  }

  .boku-subtitle {
    font-size: 1.1rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .boku-price-row {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
  }

  .boku-price {
    font-size: 1.8rem;
    font-weight: 600;
  }

  .boku-compare-price {
    text-decoration: line-through;
    color: #999;
    font-size: 1.2rem;
  }

  .boku-offer-label {
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 12px;
    display: block;
    text-transform: uppercase;
  }

  .boku-variants {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 30px;
  }

  .boku-variant-card {
    border: 1px solid #e0e0e0;
    padding: 15px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
    position: relative;
  }

  .boku-variant-card.active {
    border: 2px solid #000;
    background: #fcfcfc;
  }

  .boku-variant-card .badge {
    position: absolute;
    top: -10px;
    right: 10px;
    background: #000;
    color: #fff;
    font-size: 0.65rem;
    padding: 2px 8px;
    border-radius: 10px;
    font-weight: 700;
  }

  .boku-buy-btn {
    width: 100%;
    background: #000;
    color: #fff;
    border: none;
    padding: 20px;
    font-size: 1.1rem;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.3s;
    margin-bottom: 15px;
  }

  .boku-buy-btn:hover {
    background: #333;
  }

  .boku-guarantee {
    display: flex;
    justify-content: center;
    gap: 15px;
    color: #666;
    font-size: 0.85rem;
    margin-bottom: 40px;
  }

  /* Accordions */
  .boku-accordions {
    border-top: 1px solid #eee;
  }

  .boku-accordion {
    border-bottom: 1px solid #eee;
  }

  .boku-accordion summary {
    list-style: none;
    padding: 20px 0;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .boku-accordion summary::-webkit-details-marker { display: none; }

  .boku-accordion summary::after {
    content: '+';
    font-size: 1.4rem;
    font-weight: 300;
  }

  .boku-accordion[open] summary::after {
    content: '−';
  }

  .boku-accordion-content {
    padding-bottom: 25px;
    color: #444;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .boku-accordion-content ul {
    padding-left: 20px;
    margin: 0;
  }
</style>

<div class="boku-wrapper">
  <div class="boku-grid">
    
    <!-- Left: Gallery (Loop through all images) -->
    <div class="boku-media">
      {% for media in product.media %}
        <div class="boku-media-item" style="margin-bottom: 20px;">
          {% case media.media_type %}
            {% when 'image' %}
              {{ media | image_url: width: 1000 | image_tag: loading: 'lazy', alt: media.alt | escape }}
            {% when 'video', 'external_video' %}
              <div class="video-wrapper" style="position: relative; padding-bottom: 56.25%;">
                {{ media | video_tag: controls: true, style: "position: absolute; top:0; left:0; width:100%; height:100%; border-radius: 12px;" }}
              </div>
            {% when 'model' %}
              {{ media | model_viewer_tag }}
          {% endcase %}
        </div>
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endfor %}
    </div>

    <!-- Right: Product Info -->
    <div class="boku-info">
      <span class="boku-tagline">Technologie Clinique • Anti-Âge</span>
      <h1 class="boku-title">{{ product.title }}</h1>
      <p class="boku-subtitle">Dites adieu aux cernes et poches grâce à la synergie de la Lumière Rouge et des micro-courants EMS.</p>

      <div class="boku-price-row">
        <span class="boku-price">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="boku-compare-price">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>

      <span class="boku-offer-label">Choisissez votre pack</span>
      <div class="boku-variants">
        <div class="boku-variant-card active">
          <strong>PACK SOLO</strong>
          <div style="font-size: 0.8rem; color: #666;">1x Masseur Oculaire</div>
        </div>
        <div class="boku-variant-card">
          <span class="badge">-25% OFF</span>
          <strong>PACK DUO</strong>
          <div style="font-size: 0.8rem; color: #666;">2x Masseur (Idéal Cadeau)</div>
        </div>
      </div>

      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="boku-buy-btn">PROFITER DE L'OFFRE</button>
      {% endform %}

      <div class="boku-guarantee">
        <span>✅ Livraison 48h Offerte</span>
        <span>🛡️ Garantie 30 Jours</span>
      </div>

      <!-- Accordions -->
      <div class="boku-accordions">
        <details class="boku-accordion" open>
          <summary>✨ Pourquoi ça fonctionne ?</summary>
          <div class="boku-accordion-content">
            <p>Le EyeLuxe Pro combine trois technologies de pointe pour des résultats visibles en 7 jours :</p>
            <ul>
              <li><strong>Lumière Rouge 660nm :</strong> Stimule la production de collagène naturelle.</li>
              <li><strong>Micro-courants EMS :</strong> Raffermit et lifte les muscles peauciers.</li>
              <li><strong>Chaleur Thermale :</strong> Booste l'absorption de vos crèmes et sérums.</li>
            </ul>
          </div>
        </details>

        <details class="boku-accordion">
          <summary>📖 Comment l'utiliser ?</summary>
          <div class="boku-accordion-content">
            <p>Une routine simple de 5 minutes par œil, 3 fois par semaine suffit :</p>
            <ol>
              <li>Nettoyez votre visage et appliquez votre contour des yeux habituel.</li>
              <li>Allumez l'appareil et sélectionnez le mode souhaité.</li>
              <li>Faites glisser doucement de l'intérieur vers l'extérieur de l'œil.</li>
            </ol>
          </div>
        </details>

        <details class="boku-accordion">
          <summary>📦 Livraison & Garantie</summary>
          <div class="boku-accordion-content">
            <p>Expédition sous 24h depuis nos entrepôts. Livraison suivie gratuite en France métropolitaine.</p>
            <p>Si vous n'êtes pas satisfaite des résultats après 30 jours, nous vous remboursons intégralement, sans poser de questions.</p>
          </div>
        </details>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "BOKU-PRODUCT-PAGE",
  "settings": [],
  "presets": [
    {
      "name": "BOKU-PRODUCT-PAGE"
    }
  ]
}
{% endschema %}
