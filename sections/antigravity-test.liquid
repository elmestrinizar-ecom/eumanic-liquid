<div id="achat-produit" style="position: absolute; top: -100px;"></div>
{% liquid
  assign product = all_products['eyeluxe-pro'] | default: product
%}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const colorRadios = document.querySelectorAll('input[name="color-choice"]');
    const mediaContainer = document.querySelector('.boku-media');

    colorRadios.forEach(radio => {
      radio.addEventListener('change', function() {
        const selectedColor = this.value;
        const targetIndex = selectedColor === 'blanc' ? '0' : '1';
        const targetMedia = mediaContainer.querySelector(`.boku-media-item[data-index="${targetIndex}"]`);

        if (targetMedia && mediaContainer.firstChild !== targetMedia) {
          mediaContainer.prepend(targetMedia);
          // Scroll to top of media container to show the change
          mediaContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');

  .boku-wrapper {
    font-family: 'Inter', sans-serif;
    color: #1a1a1a;
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
    background: #fff;
  }

  .boku-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  @media (max-width: 768px) {
    .boku-grid { grid-template-columns: 1fr; gap: 30px; }
    .boku-wrapper { padding: 30px 15px; }
  }

  .boku-media img {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: transform 0.3s ease;
  }

  .boku-media img:hover {
    transform: scale(1.02);
  }

  .boku-info {
    position: sticky;
    top: 40px;
  }

  .boku-tagline {
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #E63946; /* Premium medical red */
    margin-bottom: 10px;
    display: block;
  }

  .boku-title {
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 15px;
    color: #1D3557; /* Deep Navy Medical */
  }

  .boku-subtitle {
    font-size: 1.1rem;
    color: #457B9D; /* Soft medical blue */
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .boku-price-row {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
  }

  .boku-price {
    font-size: 1.8rem;
    font-weight: 600;
  }

  .boku-compare-price {
    text-decoration: line-through;
    color: #999;
    font-size: 1.2rem;
  }

  .boku-offer-label {
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 12px;
    display: block;
    text-transform: uppercase;
  }

  .boku-variants {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 30px;
  }

  .boku-variant-card {
    border: 1px solid #e0e0e0;
    padding: 15px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
    position: relative;
  }

  .boku-variant-card.active {
    border: 2px solid #000;
    background: #fcfcfc;
  }

  .boku-variant-card .badge {
    position: absolute;
    top: -10px;
    right: 10px;
    background: #000;
    color: #fff;
    font-size: 0.65rem;
    padding: 2px 8px;
    border-radius: 10px;
    font-weight: 700;
  }

  .boku-buy-btn {
    width: 100%;
    background: #000;
    color: #fff;
    border: none;
    padding: 20px;
    font-size: 1.1rem;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.3s;
    margin-bottom: 15px;
  }

  .boku-buy-btn:hover {
    background: #333;
  }

  .boku-guarantee {
    display: flex;
    justify-content: center;
    gap: 15px;
    color: #666;
    font-size: 0.85rem;
    margin-bottom: 40px;
  }

  /* Accordions */
  .boku-accordions {
    border-top: 1px solid #eee;
  }

  .boku-accordion {
    border-bottom: 1px solid #eee;
  }

  .boku-accordion summary {
    list-style: none;
    padding: 20px 0;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .boku-accordion summary::-webkit-details-marker { display: none; }

  .boku-accordion summary::after {
    content: '+';
    font-size: 1.4rem;
    font-weight: 300;
  }

  .boku-accordion[open] summary::after {
    content: '−';
  }

  .boku-accordion-content {
    padding-bottom: 25px;
    color: #444;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .boku-accordion-content ul {
    padding-left: 20px;
    margin: 0;
  }

  /* Color Selector Styles */
  .boku-color-swatch-wrapper {
    cursor: pointer;
    text-align: center;
  }
  .boku-color-swatch {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    margin: 0 auto;
  }
  .boku-color-swatch-wrapper input:checked + .boku-color-swatch {
    transform: scale(1.2);
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #1a1a1a;
  }
</style>

<div id="achat-produit" class="boku-wrapper">
  <div class="boku-grid">
    
    <!-- Left: Gallery (Loop through all images) -->
    <div class="boku-media">
      {% for media in product.media %}
        <div class="boku-media-item" data-index="{{ forloop.index0 }}" style="margin-bottom: 20px;">
          {% case media.media_type %}
            {% when 'image' %}
              {{ media | image_url: width: 1000 | image_tag: loading: 'lazy', alt: media.alt | escape }}
            {% when 'video', 'external_video' %}
              <div class="video-wrapper" style="position: relative; padding-bottom: 56.25%;">
                {{ media | video_tag: controls: true, style: "position: absolute; top:0; left:0; width:100%; height:100%; border-radius: 12px;" }}
              </div>
            {% when 'model' %}
              {{ media | model_viewer_tag }}
          {% endcase %}
        </div>
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endfor %}
    </div>

    <!-- Right: Product Info -->
    <div class="boku-info">
      <span class="boku-tagline">Technologie Clinique • Anti-Âge</span>
      <h1 class="boku-title">{{ product.title }}</h1>
      <p class="boku-subtitle" style="margin-bottom: 10px !important;">Dites adieu aux cernes et poches grâce à la synergie de la Lumière Rouge et des micro-courants EMS.</p>

      <!-- BLOC AVIS (Style Boku - Étoiles Rouges) -->
      <div style="display: flex !important; align-items: center !important; gap: 8px !important; margin-bottom: 25px !important;">
        <div style="display: flex !important; color: #E63946 !important; font-size: 1rem !important;">
          ★★★★★
        </div>
        <span style="font-size: 0.9rem !important; fontWeight: 600 !important; color: #1D3557 !important;">
          +<strong>250 utilisateurs</strong> quotidiens satisfaits
        </span>
      </div>

      <!-- LISTE D'AVANTAGES (Bullet Points Rouges) -->
      <div class="boku-benefits" style="margin-bottom: 30px !important;">
        <ul style="list-style: none !important; padding: 0 !important; margin: 0 !important;">
          <li style="display: flex !important; align-items: center !important; gap: 12px !important; margin-bottom: 12px !important; font-size: 1.05rem !important; font-weight: 500 !important; color: #1D3557 !important;">
            <span style="display: flex !important; align-items: center !important; justify-content: center !important; width: 22px !important; height: 22px !important; background: #E63946 !important; border-radius: 50% !important; color: white !important; font-size: 12px !important;">✓</span>
            Nettoie vos cernes grâce à la Photothérapie
          </li>
          <li style="display: flex !important; align-items: center !important; gap: 12px !important; margin-bottom: 12px !important; font-size: 1.05rem !important; font-weight: 500 !important; color: #1D3557 !important;">
            <span style="display: flex !important; align-items: center !important; justify-content: center !important; width: 22px !important; height: 22px !important; background: #E63946 !important; border-radius: 50% !important; color: white !important; font-size: 12px !important;">✓</span>
            Élimine les poches en 10 minutes
          </li>
          <li style="display: flex !important; align-items: center !important; gap: 12px !important; margin-bottom: 12px !important; font-size: 1.05rem !important; font-weight: 500 !important; color: #1D3557 !important;">
            <span style="display: flex !important; align-items: center !important; justify-content: center !important; width: 22px !important; height: 22px !important; background: #E63946 !important; border-radius: 50% !important; color: white !important; font-size: 12px !important;">✓</span>
            10x plus efficace que les crèmes classiques
          </li>
          <li style="display: flex !important; align-items: center !important; gap: 12px !important; margin-bottom: 12px !important; font-size: 1.05rem !important; font-weight: 500 !important; color: #1D3557 !important;">
            <span style="display: flex !important; align-items: center !important; justify-content: center !important; width: 22px !important; height: 22px !important; background: #E63946 !important; border-radius: 50% !important; color: white !important; font-size: 12px !important;">✓</span>
            Massage relaxant et anti-rides par micro-vibrations
          </li>
          <li style="display: flex !important; align-items: center !important; gap: 12px !important; margin-bottom: 12px !important; font-size: 1.05rem !important; font-weight: 500 !important; color: #1D3557 !important;">
            <span style="display: flex !important; align-items: center !important; justify-content: center !important; width: 22px !important; height: 22px !important; background: #E63946 !important; border-radius: 50% !important; color: white !important; font-size: 12px !important;">✓</span>
            Résultats cliniques visibles dès 7 jours
          </li>
          <li style="display: flex !important; align-items: center !important; gap: 12px !important; margin-bottom: 12px !important; font-size: 1.05rem !important; font-weight: 500 !important; color: #1D3557 !important;">
            <span style="display: flex !important; align-items: center !important; justify-content: center !important; width: 22px !important; height: 22px !important; background: #E63946 !important; border-radius: 50% !important; color: white !important; font-size: 12px !important;">✓</span>
            Réduit vos rides du visage de 80%
          </li>
        </ul>
      </div>

      <div class="boku-price-row">
        <span class="boku-price">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="boku-compare-price">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>

      <div class="boku-color-selector" style="margin-bottom: 30px;">
        <span class="boku-offer-label">Choisissez votre COULEUR</span>
        <div style="display: flex; gap: 15px;">
          <label class="boku-color-swatch-wrapper">
            <input type="radio" name="color-choice" value="blanc" checked style="display: none;">
            <div class="boku-color-swatch" style="background: #FFFFFF; border: 1px solid #e0e0e0; width: 35px; height: 35px; border-radius: 50%;" title="Blanc"></div>
            <span style="font-size: 0.8rem; font-weight: 600; margin-top: 5px; display: block;">Blanc</span>
          </label>
          <label class="boku-color-swatch-wrapper">
            <input type="radio" name="color-choice" value="rouge" style="display: none;">
            <div class="boku-color-swatch" style="background: #E63946; width: 35px; height: 35px; border-radius: 50%;" title="Rouge"></div>
            <span style="font-size: 0.8rem; font-weight: 600; margin-top: 5px; display: block;">Rouge</span>
          </label>
        </div>
      </div>

      <span class="boku-offer-label">Choisissez votre pack</span>
      <div class="boku-variants">
        <div class="boku-variant-card active">
          <strong>PACK SOLO</strong>
          <div style="font-size: 0.8rem; color: #666;">1x Masseur Oculaire</div>
        </div>
        <div class="boku-variant-card">
          <span class="badge" style="background: #E63946 !important;">-25% OFF</span>
          <strong>PACK DUO</strong>
          <div style="font-size: 0.8rem; color: #666;">2x Masseur (Idéal Cadeau)</div>
        </div>
      </div>

      <!-- Custom Cart Overlay -->
      <div id="custom-cart-overlay" style="display:none; position:fixed; inset:0; z-index:9998; background:rgba(0,0,0,0.5); opacity:0; transition: opacity 0.3s ease;"></div>
      <div id="custom-cart-drawer" style="
        display:none; position:fixed; top:0; right:0; bottom:0; z-index:9999;
        width:420px; max-width:92vw; background:#fff; box-shadow:-8px 0 30px rgba(0,0,0,0.15);
        transform:translateX(100%); transition:transform 0.35s cubic-bezier(0.4,0,0.2,1);
        font-family:'Inter',sans-serif; overflow-y:auto;
      ">
        <!-- Header -->
        <div style="display:flex; align-items:center; justify-content:space-between; padding:20px 24px; border-bottom:1px solid #eee;">
          <h3 style="margin:0; font-size:1.1rem; font-weight:700; color:#1D3557;">🛒 Votre Panier</h3>
          <button id="custom-cart-close" style="background:none; border:none; font-size:1.6rem; cursor:pointer; color:#999; line-height:1; padding:4px 8px;">✕</button>
        </div>

        <!-- Product Summary -->
        <div style="padding:24px;">
          <div style="display:flex; gap:16px; margin-bottom:20px;">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title }}" style="width:90px; height:90px; object-fit:cover; border-radius:10px; border:1px solid #eee;">
            {% endif %}
            <div style="flex:1;">
              <p style="margin:0 0 4px 0; font-weight:700; font-size:1rem; color:#1D3557;">{{ product.title }}</p>
              <p id="cart-drawer-color" style="margin:0 0 4px 0; font-size:0.85rem; color:#666;">Couleur : <strong>Blanc</strong></p>
              <p id="cart-drawer-pack" style="margin:0 0 4px 0; font-size:0.85rem; color:#666;">Pack : <strong>SOLO (1x)</strong></p>
              <p id="cart-drawer-price" style="margin:0; font-size:1.15rem; font-weight:700; color:#E63946;">{{ product.price | money }}</p>
            </div>
          </div>

          <!-- Divider -->
          <div style="border-top:1px solid #eee; margin:20px 0;"></div>

          <!-- Promo Code -->
          <div style="margin-bottom:20px;">
            <label style="display:block; font-size:0.85rem; font-weight:600; color:#1D3557; margin-bottom:8px;">Code de réduction</label>
            <div style="display:flex; gap:8px;">
              <input id="promo-code-input" type="text" placeholder="Entrer le code" style="
                flex:1; padding:12px 14px; border:1.5px solid #ddd; border-radius:8px;
                font-size:0.9rem; outline:none; transition:border-color 0.2s;
                font-family:'Inter',sans-serif;
              ">
              <button id="promo-code-apply" style="
                background:#1D3557; color:#fff; border:none; padding:12px 18px;
                border-radius:8px; font-size:0.85rem; font-weight:700; cursor:pointer;
                transition:background 0.2s; white-space:nowrap;
              ">Appliquer</button>
            </div>
            <p id="promo-code-msg" style="margin:6px 0 0 0; font-size:0.8rem; display:none;"></p>
          </div>

          <!-- Totals -->
          <div style="background:#f8f9fa; border-radius:10px; padding:16px; margin-bottom:20px;">
            <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
              <span style="font-size:0.9rem; color:#666;">Sous-total</span>
              <span id="cart-subtotal" style="font-size:0.9rem; font-weight:600;">{{ product.price | money }}</span>
            </div>
            <div id="cart-discount-row" style="display:none; justify-content:space-between; margin-bottom:8px;">
              <span style="font-size:0.9rem; color:#2d8a4e;">Réduction</span>
              <span id="cart-discount-amount" style="font-size:0.9rem; font-weight:600; color:#2d8a4e;">-€0,00</span>
            </div>
            <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
              <span style="font-size:0.9rem; color:#666;">Livraison</span>
              <span style="font-size:0.9rem; font-weight:600; color:#2d8a4e;">GRATUITE</span>
            </div>
            <div style="border-top:1px solid #ddd; padding-top:10px; margin-top:10px; display:flex; justify-content:space-between;">
              <span style="font-size:1rem; font-weight:700; color:#1D3557;">Total</span>
              <span id="cart-total" style="font-size:1.15rem; font-weight:800; color:#1D3557;">{{ product.price | money }}</span>
            </div>
          </div>

          <!-- Checkout Button -->
          <a id="cart-checkout-btn" href="/checkout" style="
            display:block; text-align:center; background:#E63946; color:#fff !important;
            text-decoration:none; padding:18px; border-radius:10px; font-size:1.05rem;
            font-weight:800; letter-spacing:0.5px; transition:background 0.2s;
            text-transform:uppercase;
          ">PASSER À LA CAISSE</a>


        </div>
      </div>

      <button
        type="button"
        id="ajax-add-to-cart"
        class="boku-buy-btn"
        style="background: #E63946 !important;"
        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
        data-product-price="{{ product.price }}"
      >PROFITER DE L'OFFRE</button>

      <script>
      (function() {
        var addBtn = document.getElementById('ajax-add-to-cart');
        if (!addBtn) return;

        var variantId = parseInt(addBtn.getAttribute('data-variant-id'));
        var unitPrice = parseInt(addBtn.getAttribute('data-product-price'));
        var selectedPack = 'solo';
        var selectedColor = 'Blanc';

        /* ══ Cart Drawer Elements ══ */
        var overlay = document.getElementById('custom-cart-overlay');
        var drawer = document.getElementById('custom-cart-drawer');
        var closeBtn = document.getElementById('custom-cart-close');
        var drawerColor = document.getElementById('cart-drawer-color');
        var drawerPack = document.getElementById('cart-drawer-pack');
        var drawerPrice = document.getElementById('cart-drawer-price');
        var subtotalEl = document.getElementById('cart-subtotal');
        var totalEl = document.getElementById('cart-total');

        function formatPrice(cents) {
          return '€' + (cents / 100).toFixed(2).replace('.', ',');
        }

        /* ── Pack selection (Solo = 1x, Duo = 2x) ── */
        var variantCards = document.querySelectorAll('.boku-variant-card');
        variantCards.forEach(function(card, index) {
          card.addEventListener('click', function() {
            variantCards.forEach(function(c) { c.classList.remove('active'); });
            card.classList.add('active');
            selectedPack = (index === 0) ? 'solo' : 'duo';
          });
        });

        /* ── Color selection ── */
        document.querySelectorAll('input[name="color-choice"]').forEach(function(radio) {
          radio.addEventListener('change', function() {
            selectedColor = (this.value === 'rouge') ? 'Rouge' : 'Blanc';
          });
        });

        /* ── Open / Close Custom Cart Drawer ── */
        function openCustomCart(qty) {
          var total = unitPrice * qty;
          var packLabel = (selectedPack === 'duo') ? 'DUO (2x)' : 'SOLO (1x)';

          drawerColor.innerHTML = 'Couleur : <strong>' + selectedColor + '</strong>';
          drawerPack.innerHTML = 'Pack : <strong>' + packLabel + '</strong>';
          drawerPrice.textContent = formatPrice(total);
          subtotalEl.textContent = formatPrice(total);
          totalEl.textContent = formatPrice(total);

          overlay.style.display = 'block';
          drawer.style.display = 'block';
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              overlay.style.opacity = '1';
              drawer.style.transform = 'translateX(0)';
            });
          });
          document.body.style.overflow = 'hidden';
        }

        function closeCustomCart() {
          overlay.style.opacity = '0';
          drawer.style.transform = 'translateX(100%)';
          setTimeout(function() {
            overlay.style.display = 'none';
            drawer.style.display = 'none';
            document.body.style.overflow = '';
          }, 350);
        }

        closeBtn.addEventListener('click', closeCustomCart);
        overlay.addEventListener('click', closeCustomCart);

        /* ── AJAX Add to Cart ── */
        addBtn.addEventListener('click', function() {
          var quantity = (selectedPack === 'duo') ? 2 : 1;

          addBtn.disabled = true;
          addBtn.textContent = 'AJOUT EN COURS…';

          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: [{ id: variantId, quantity: quantity }] })
          })
          .then(function(res) {
            if (!res.ok) return res.json().then(function(e) { throw new Error(e.description || 'Erreur'); });
            return res.json();
          })
          .then(function() {
            addBtn.textContent = '✓ AJOUTÉ !';
            setTimeout(function() {
              addBtn.disabled = false;
              addBtn.textContent = 'PROFITER DE L\'OFFRE';
            }, 2500);
            openCustomCart(quantity);
          })
          .catch(function(err) {
            addBtn.disabled = false;
            addBtn.textContent = 'PROFITER DE L\'OFFRE';
            alert('Erreur: ' + err.message);
          });
        });

        /* ── Promo Code ── */
        var promoInput = document.getElementById('promo-code-input');
        var promoBtn = document.getElementById('promo-code-apply');
        var promoMsg = document.getElementById('promo-code-msg');

        promoInput.addEventListener('focus', function() {
          this.style.borderColor = '#E63946';
        });
        promoInput.addEventListener('blur', function() {
          this.style.borderColor = '#ddd';
        });

        promoBtn.addEventListener('click', function() {
          var code = promoInput.value.trim();
          if (!code) return;

          promoBtn.textContent = '...';
          promoBtn.disabled = true;

          /* Apply discount code via Shopify's discount URL mechanism */
          fetch('/discount/' + encodeURIComponent(code), {
            method: 'GET',
            redirect: 'follow'
          })
          .then(function() {
            /* Fetch updated cart to check if discount applied */
            return fetch('/cart.js').then(function(r) { return r.json(); });
          })
          .then(function(cart) {
            promoBtn.textContent = 'Appliquer';
            promoBtn.disabled = false;

            if (cart.cart_level_discount_applications && cart.cart_level_discount_applications.length > 0) {
              var discount = cart.cart_level_discount_applications[0];
              promoMsg.style.display = 'block';
              promoMsg.style.color = '#2d8a4e';
              promoMsg.textContent = '✓ Code "' + discount.title + '" appliqué !';

              var discountRow = document.getElementById('cart-discount-row');
              discountRow.style.display = 'flex';
              document.getElementById('cart-discount-amount').textContent = '-' + formatPrice(discount.total_allocated_amount);
              totalEl.textContent = formatPrice(cart.total_price);
            } else {
              /* Check line-level discounts */
              var hasLineDiscount = false;
              var totalDiscount = 0;
              cart.items.forEach(function(item) {
                if (item.line_level_discount_allocations && item.line_level_discount_allocations.length > 0) {
                  hasLineDiscount = true;
                  item.line_level_discount_allocations.forEach(function(d) {
                    totalDiscount += d.amount;
                  });
                }
              });

              if (hasLineDiscount) {
                promoMsg.style.display = 'block';
                promoMsg.style.color = '#2d8a4e';
                promoMsg.textContent = '✓ Code appliqué !';
                var discountRow = document.getElementById('cart-discount-row');
                discountRow.style.display = 'flex';
                document.getElementById('cart-discount-amount').textContent = '-' + formatPrice(totalDiscount);
                totalEl.textContent = formatPrice(cart.total_price);
              } else {
                promoMsg.style.display = 'block';
                promoMsg.style.color = '#E63946';
                promoMsg.textContent = '✗ Code invalide ou expiré';
              }
            }
          })
          .catch(function() {
            promoBtn.textContent = 'Appliquer';
            promoBtn.disabled = false;
            promoMsg.style.display = 'block';
            promoMsg.style.color = '#E63946';
            promoMsg.textContent = '✗ Erreur, veuillez réessayer';
          });
        });

      })();
      </script>


