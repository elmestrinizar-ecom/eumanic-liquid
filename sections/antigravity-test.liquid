{% liquid
  assign product = all_products['eyeluxe-pro'] | default: product
%}

<div class="boku-product-container" style="padding: 20px; font-family: sans-serif; background: #fff;">
  <div style="display: flex; flex-wrap: wrap; gap: 40px;">
    
    <!-- Media Gallery (Simplifié pour le test) -->
    <div style="flex: 1; min-width: 300px;">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 800 }}" style="width: 100%; border-radius: 8px;">
      {% endif %}
    </div>

    <!-- Product Info -->
    <div style="flex: 1; min-width: 300px;">
      <h1 style="font-size: 2.5rem; margin-bottom: 10px;">{{ product.title }}</h1>
      <p style="color: #666; font-size: 1.1rem; margin-bottom: 20px;">Masseur Oculaire Intelligent - Technologie EMS & Lumière Rouge</p>
      
      <div style="font-size: 1.5rem; font-weight: bold; margin-bottom: 25px;">
        {{ product.price | money }}
      </div>

      <!-- Fake Variant Picker for Boku Style -->
      <div style="margin-bottom: 30px;">
        <label style="display: block; font-weight: bold; margin-bottom: 10px;">CHOISISSEZ VOTRE OFFRE</1>
        <div style="display: flex; gap: 10px;">
          <div style="border: 2px solid #000; padding: 10px 20px; border-radius: 4px; cursor: pointer; background: #f9f9f9;">
            <strong>SOLO</strong><br>1x Eumanic
          </div>
          <div style="border: 1px solid #ddd; padding: 10px 20px; border-radius: 4px; cursor: pointer;">
            <strong>DUO (Best Seller)</strong><br>2x Eumanic (-20%)
          </div>
        </div>
      </div>

      <!-- Add to Cart (Standard) -->
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" style="width: 100%; padding: 15px; background: #000; color: #fff; border: none; border-radius: 4px; font-weight: bold; font-size: 1.1rem; cursor: pointer;">
          AJOUTER AU PANIER
        </button>
      {% endform %}

      <!-- Accordions -->
      <div style="margin-top: 40px; border-top: 1px solid #eee;">
        <details open style="padding: 15px 0; border-bottom: 1px solid #eee; cursor: pointer;">
          <summary style="font-weight: bold; font-size: 1.1rem;">✨ Fonctionnalités</summary>
          <div style="padding-top: 10px; color: #444; line-height: 1.6;">
            <ul>
              <li>Lumière Rouge (Anti-Âge/Cernes)</li>
              <li>Micro-courants EMS (Liftant)</li>
              <li>Chaleur Apaisante (42°C)</li>
            </ul>
          </div>
        </details>
        
        <details style="padding: 15px 0; border-bottom: 1px solid #eee; cursor: pointer;">
          <summary style="font-weight: bold; font-size: 1.1rem;">📖 Utilisation</summary>
          <div style="padding-top: 10px; color: #444;">
            1. Appliquez votre sérum.<br>
            2. Massez 5 min par œil.<br>
            3. Admirez le résultat.
          </div>
        </details>

        <details style="padding: 15px 0; border-bottom: 1px solid #eee; cursor: pointer;">
          <summary style="font-weight: bold; font-size: 1.1rem;">🚚 Livraison & Retours</summary>
          <div style="padding-top: 10px; color: #444;">
            Livraison Gratuite (48h). Retours gratuits sous 30 jours.
          </div>
        </details>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "AAA-BOKU-DESIGN",
  "settings": [],
  "presets": [
    {
      "name": "AAA-BOKU-DESIGN"
    }
  ]
}
{% endschema %}
