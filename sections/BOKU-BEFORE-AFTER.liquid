{% comment %}
  Section: BOKU-BEFORE-AFTER
  Inspirée de CurrentBody / Boku
{% endcomment %}

<style>
  .boku-ba-section {
    background: #ffffff;
    padding: 60px 0;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }
  .boku-ba-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .boku-ba-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .boku-ba-pre-title {
    color: #E63946;
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 10px;
  }
  .boku-ba-title {
    color: #1D3557;
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0 0 15px 0;
  }
  .boku-ba-subtitle {
    color: #666;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
    font-size: 1.1rem;
  }

  /* Marquee/Carousel Logic */
  .boku-ba-marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 30px;
    padding: 20px 0;
  }
  .boku-ba-track {
    display: flex;
    gap: 30px;
    animation: scroll-ba 40s linear infinite;
    flex-shrink: 0;
  }
  
  @keyframes scroll-ba {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - 30px)); }
  }

  .boku-ba-marquee:hover .boku-ba-track {
    animation-play-state: paused;
  }

  /* Card Design */
  .boku-ba-card {
    width: 380px;
    flex-shrink: 0;
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    /* transition: transform 0.3s ease; */
  }
  .boku-ba-images {
    display: flex;
    gap: 2px;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    height: 280px;
  }
  .boku-ba-img-wrapper {
    width: 50%;
    position: relative;
  }
  .boku-ba-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .boku-ba-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(255, 255, 255, 0.9);
    color: #1D3557;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    z-index: 2;
  }
  .boku-ba-badge.after {
    left: auto;
    right: 12px;
  }

  .boku-ba-content {
    padding: 20px 5px;
  }
  .boku-ba-card-title {
    color: #1D3557;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 8px 0;
  }
  .boku-ba-info {
    font-size: 0.85rem;
    color: #888;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .boku-ba-check {
    color: #E63946;
    font-weight: bold;
  }
  .boku-ba-quote {
    color: #444;
    font-size: 0.95rem;
    line-height: 1.5;
    font-style: italic;
    margin: 0;
  }

  @media (max-width: 768px) {
    .boku-ba-title { font-size: 1.8rem; }
    .boku-ba-card { width: 320px; }
    .boku-ba-images { height: 240px; }
  }
</style>

