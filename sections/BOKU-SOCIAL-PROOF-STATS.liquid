<style>
  .boku-social-proof-section {
    background: #F8F9FA;
    padding: 100px 20px;
    font-family: 'Inter', sans-serif;
    color: #1D3557;
  }
  .boku-social-proof-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  @media (max-width: 968px) {
    .boku-social-proof-container {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }

  /* Left Side - Statistics */
  .boku-social-proof-left h2 {
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1.3;
    margin-bottom: 50px;
    color: #1D3557;
  }
  .boku-social-proof-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 50px;
  }
  @media (max-width: 600px) {
    .boku-social-proof-stats {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
  .boku-stat-item {
    display: flex;
    flex-direction: column;
  }
  .boku-stat-number {
    font-size: 3.5rem;
    font-weight: 900;
    color: #1D3557;
    line-height: 1;
    margin-bottom: 10px;
  }
  .boku-stat-description {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #444;
  }
  .boku-social-proof-cta {
    display: inline-block;
    background: #1D3557;
    color: #ffffff;
    padding: 16px 32px;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 1rem;
  }
  .boku-social-proof-cta:hover {
    background: #E63946;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(230, 57, 70, 0.2);
  }

  /* Right Side - Scrolling Photos */
  .boku-social-proof-right {
    position: relative;
    height: 600px;
    overflow: hidden;
    border-radius: 20px;
  }
  @media (max-width: 968px) {
    .boku-social-proof-right {
      height: 500px;
    }
  }
  .boku-photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    animation: scrollPhotos 30s linear infinite;
  }
  @keyframes scrollPhotos {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-50%);
    }
  }
  .boku-photo-grid:hover {
    animation-play-state: paused;
  }
  .boku-photo-item {
    border-radius: 15px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #ddd;
  }
  .boku-photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<div class="boku-social-proof-section">
