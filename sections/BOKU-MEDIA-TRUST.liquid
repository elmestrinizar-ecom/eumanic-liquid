<style>
  .boku-media-trust-section {
    background: #ffffff;
    padding: 15px 0; /* Thinner section */
    overflow: hidden;
    border-top: 1px solid #f2f2f2;
    border-bottom: 1px solid #f2f2f2;
  }
  .boku-media-track-container {
    display: flex;
    overflow: hidden;
    user-select: none;
  }
  .boku-media-track {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0; /* Gap is inside the image strip now */
    animation: scroll-media-logos 60s linear infinite;
  }
  @keyframes scroll-media-logos {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }
  .boku-media-logo-img {
    height: 25px; /* Perfect height like Sinezy */
    width: auto;
    filter: none; /* No more grey/faint filter */
    opacity: 1; /* Full opacity */
    display: block;
    margin: 0;
  }
  
  /* Pause on hover */
  .boku-media-track-container:hover .boku-media-track {
    animation-play-state: paused;
  }

  @media (max-width: 768px) {
    .boku-media-trust-section {
      padding: 10px 0;
    }
    .boku-media-logo-img {
      height: 18px;
    }
  }
</style>

<div class="boku-media-trust-section">
  <div class="boku-media-track-container">
    <div class="boku-media-track">
      <img src="{{ 'media-trust-logos-v3.png' | asset_url }}" alt="Media Trust" class="boku-media-logo-img" loading="lazy">
      <img src="{{ 'media-trust-logos-v3.png' | asset_url }}" alt="Media Trust" class="boku-media-logo-img" loading="lazy">
      <img src="{{ 'media-trust-logos-v3.png' | asset_url }}" alt="Media Trust" class="boku-media-logo-img" loading="lazy">
    </div>
    <div class="boku-media-track" aria-hidden="true">
      <img src="{{ 'media-trust-logos-v3.png' | asset_url }}" alt="Media Trust" class="boku-media-logo-img" loading="lazy">
      <img src="{{ 'media-trust-logos-v3.png' | asset_url }}" alt="Media Trust" class="boku-media-logo-img" loading="lazy">
      <img src="{{ 'media-trust-logos-v3.png' | asset_url }}" alt="Media Trust" class="boku-media-logo-img" loading="lazy">
    </div>
  </div>
</div>

