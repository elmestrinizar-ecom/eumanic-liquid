<div id="achat-produit" style="position: absolute; top: -100px;"></div>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');

  .boku-featured {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
    font-family: 'Inter', sans-serif;
    text-align: center;
  }

  .boku-featured__badge {
    display: inline-block;
    background: linear-gradient(135deg, #E63946 0%, #ff6b7a 100%);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 6px 18px;
    border-radius: 20px;
    margin-bottom: 18px;
    animation: boku-pulse 2s ease-in-out infinite;
  }

  @keyframes boku-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(230, 57, 70, 0.4); }
    50% { box-shadow: 0 0 0 10px rgba(230, 57, 70, 0); }
  }

  .boku-featured__title {
    font-size: 2rem;
    font-weight: 700;
    color: #1D3557;
    margin: 0 0 10px 0;
    line-height: 1.2;
  }

  .boku-featured__subtitle {
    font-size: 1.05rem;
    color: #457B9D;
    margin: 0 0 40px 0;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }

  .boku-featured__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 30px;
    margin-bottom: 40px;
  }

  @media (max-width: 600px) {
    .boku-featured__grid { grid-template-columns: 1fr; }
    .boku-featured__title { font-size: 1.6rem; }
  }

  .boku-featured__card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    color: inherit;
    display: block;
    position: relative;
  }

  .boku-featured__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(230, 57, 70, 0.12);
  }

  .boku-featured__card-img-wrap {
    position: relative;
    background: linear-gradient(180deg, #fdf2f3 0%, #fff 100%);
    padding: 30px;
    overflow: hidden;
  }

  .boku-featured__card-img-wrap::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #E63946, #ff6b7a, #E63946);
    background-size: 200% auto;
    animation: boku-shimmer 3s ease-in-out infinite;
  }

  @keyframes boku-shimmer {
    0% { background-position: 0% center; }
    50% { background-position: 100% center; }
    100% { background-position: 0% center; }
  }

  .boku-featured__card-img {
    width: 100%;
    max-width: 250px;
    height: auto;
    margin: 0 auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .boku-featured__card:hover .boku-featured__card-img {
    transform: scale(1.05);
  }

  .boku-featured__card-body {
    padding: 20px;
  }

  .boku-featured__card-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1D3557;
    margin: 0 0 6px 0;
  }

  .boku-featured__card-desc {
    font-size: 0.85rem;
    color: #666;
    margin: 0 0 12px 0;
    line-height: 1.4;
  }

  .boku-featured__card-price {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .boku-featured__price-current {
    font-size: 1.2rem;
    font-weight: 700;
    color: #E63946;
  }

  .boku-featured__price-original {
    font-size: 0.95rem;
    color: #aaa;
    text-decoration: line-through;
  }

  .boku-featured__card-tag {
    position: absolute;
    top: 15px;
    right: 15px;
    background: #E63946;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .boku-featured__stars {
    color: #E63946;
    font-size: 0.9rem;
    letter-spacing: 2px;
    margin-bottom: 6px;
  }

  .boku-featured__cta {
    display: inline-block;
    background: linear-gradient(135deg, #E63946 0%, #d32f3f 100%);
    color: #fff;
    padding: 16px 40px;
    border-radius: 8px;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(230, 57, 70, 0.3);
  }

  .boku-featured__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(230, 57, 70, 0.4);
    background: linear-gradient(135deg, #d32f3f 0%, #E63946 100%);
  }

  .boku-featured__trust {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 25px;
    flex-wrap: wrap;
  }

  .boku-featured__trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: #666;
    font-weight: 500;
  }

  .boku-featured__trust-icon {
    font-size: 1rem;
  }
</style>

<div class="boku-featured">
  
  <div class="boku-featured__badge">✨ Exclusivité Eumanic</div>
  
  <h2 class="boku-featured__title">Nos solutions pour un regard rajeuni</h2>
  <p class="boku-featured__subtitle">Technologie clinique prouvée pour effacer cernes, poches et rides du contour des yeux.</p>

  <div class="boku-featured__grid">

    {% for product in collections['all'].products limit: 4 %}
      <a href="{{ product.url }}" class="boku-featured__card">
        
        {% if product.compare_at_price > product.price %}
          <span class="boku-featured__card-tag">-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
        {% endif %}

        <div class="boku-featured__card-img-wrap">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 500 }}" 
                 alt="{{ product.title | escape }}" 
                 class="boku-featured__card-img"
                 loading="lazy">
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'boku-featured__card-img' }}
          {% endif %}
        </div>

        <div class="boku-featured__card-body">
          <div class="boku-featured__stars">★★★★★</div>
          <h3 class="boku-featured__card-name">{{ product.title }}</h3>
          <p class="boku-featured__card-desc">Soin anti-cernes par lumière rouge & EMS</p>
          <div class="boku-featured__card-price">
            <span class="boku-featured__price-current">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="boku-featured__price-original">{{ product.compare_at_price | money }}</span>
            {% endif %}
          </div>
        </div>
      </a>
    {% endfor %}

  </div>



</div>

{% schema %}
{
  "name": "BOKU-FEATURED-PRODUCTS",
  "settings": [],
  "presets": [
    {
      "name": "BOKU-FEATURED-PRODUCTS"
    }
  ]
}
{% endschema %}
