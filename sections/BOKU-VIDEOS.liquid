<style>
  .boku-videos-section {
    max-width: 1200px;
    margin: 60px auto;
    padding: 0 20px;
    text-align: center;
    font-family: 'Inter', sans-serif;
  }
  .boku-videos-grid {
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
    margin-top: 30px;
  }
  .boku-video-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 90px;
    cursor: pointer;
  }
  .boku-video-circle {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    border: 3px solid #E63946;
    padding: 3px;
    background: #fff;
    overflow: hidden;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }
  .boku-video-item:hover .boku-video-circle {
    transform: scale(1.05);
    box-shadow: 0 8px 20px rgba(230, 57, 70, 0.2);
  }
  .boku-video-circle video.boku-thumb-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    pointer-events: none;
  }
  /* Overlay Play Icon */
  .boku-video-play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 30px;
    height: 30px;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .boku-video-play-icon svg {
    width: 14px;
    height: 14px;
    fill: #E63946;
    margin-left: 2px;
  }

  /* MODAL STYLES */
  .boku-video-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.85);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .boku-video-modal.active {
    display: flex;
  }
  .boku-video-modal-content {
    position: relative;
    width: 100%;
    max-width: 900px;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 12px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    overflow: hidden;
  }
  .boku-video-modal-close {
    position: absolute;
    top: -40px;
    right: 0;
    color: #fff;
    font-size: 30px;
    cursor: pointer;
    background: none;
    border: none;
  }
  .boku-video-modal video#bokuModalVideo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>

<div class="boku-videos-section">
  <div class="boku-videos-grid">
    
    <!-- Video 1 -->
    <div class="boku-video-item" onclick="openBokuModal('https://cdn.shopify.com/videos/c/o/v/e3d64f45ae274ed7a1ed9b7c7e2d3aa5.mp4')">
      <div class="boku-video-circle">
        <video class="boku-thumb-video" src="https://cdn.shopify.com/videos/c/o/v/e3d64f45ae274ed7a1ed9b7c7e2d3aa5.mp4#t=0.5" muted playsinline preload="metadata"></video>
        <div class="boku-video-play-icon">
          <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </div>
      </div>
    </div>

    <!-- Video 2 -->
    <div class="boku-video-item" onclick="openBokuModal('https://cdn.shopify.com/videos/c/o/v/677aca826c594dd389018a913edb6009.mp4')">
      <div class="boku-video-circle">
        <video class="boku-thumb-video" src="https://cdn.shopify.com/videos/c/o/v/677aca826c594dd389018a913edb6009.mp4#t=0.5" muted playsinline preload="metadata"></video>
        <div class="boku-video-play-icon">
          <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </div>
      </div>
    </div>

    <!-- Video 3 -->
    <div class="boku-video-item" onclick="openBokuModal('https://cdn.shopify.com/videos/c/o/v/69ac637172c749399c5c0211312ffb57.mp4')">
      <div class="boku-video-circle">
        <video class="boku-thumb-video" src="https://cdn.shopify.com/videos/c/o/v/69ac637172c749399c5c0211312ffb57.mp4#t=0.5" muted playsinline preload="metadata"></video>
        <div class="boku-video-play-icon">
          <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Modal Structure -->
<div id="bokuVideoModal" class="boku-video-modal" onclick="closeBokuModal(event)">
  <div class="boku-video-modal-content" onclick="event.stopPropagation()">
    <button class="boku-video-modal-close" onclick="closeBokuModal(event)">&times;</button>
    <video id="bokuModalVideo" playsinline muted>
      <source src="" type="video/mp4">
      Votre navigateur ne supporte pas la vidéo.
    </video>
  </div>
</div>

<script>
  function openBokuModal(videoUrl) {
    const modal = document.getElementById('bokuVideoModal');
    const video = document.getElementById('bokuModalVideo');
    if (modal && video) {
      video.src = videoUrl;
      modal.classList.add('active');
      video.play();
    }
  }

  function closeBokuModal(event) {
    const modal = document.getElementById('bokuVideoModal');
    const video = document.getElementById('bokuModalVideo');
    if (modal && video) {
      modal.classList.remove('active');
      video.pause();
      video.currentTime = 0;
      video.src = '';
    }
  }
</script>

