{% comment %}
  Section: BOKU-LEARN-MORE
  Section d'articles / contenu de marque style Boku
{% endcomment %}

<style>
  .boku-learn-section {
    background: #ffffff;
    padding: 100px 0;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }
  .boku-learn-header {
    max-width: 1300px;
    margin: 0 auto 50px auto;
    padding: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .boku-learn-title-wrap {
    max-width: 700px;
  }
  .boku-learn-title {
    color: #1D3557;
    font-size: 2.8rem;
    font-weight: 800;
    margin: 0 0 15px 0;
  }
  .boku-learn-title span {
    color: #E63946; /* Brand Red accent if needed, otherwise Navy */
  }
  .boku-learn-subtitle {
    color: #457B9D;
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
  }

  .boku-learn-nav {
    display: flex;
    gap: 12px;
  }
  .boku-learn-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid #1D3557;
    background: transparent;
    color: #1D3557;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .boku-learn-btn:hover {
    background: #1D3557;
    color: #fff;
  }

  /* Carousel */
  .boku-learn-carousel {
    display: flex;
    gap: 25px;
    padding: 0 40px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    max-width: 1600px;
    margin: 0 auto;
  }
  .boku-learn-carousel::-webkit-scrollbar { display: none; }

  .boku-learn-card {
    min-width: 320px;
    flex-shrink: 0;
    background: #f1f4f9; /* Light Boku-like background */
    border-radius: 16px;
    padding: 35px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(29, 53, 87, 0.05);
  }
  .boku-learn-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(29, 53, 87, 0.08);
  }

  .boku-learn-card-title {
    color: #1D3557;
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 20px 0;
  }
  .boku-learn-card-text {
    color: #457B9D;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 25px 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
  }
  .boku-learn-more-link {
    color: #1D3557;
    font-weight: 700;
    text-decoration: underline;
    font-size: 0.95rem;
    transition: color 0.3s ease;
  }
  .boku-learn-more-link:hover {
    color: #E63946;
  }

  /* Bottom Nav (visible only on mobile if needed) */
  .boku-learn-nav-bottom {
    display: none;
    justify-content: center;
    gap: 15px;
    margin-top: 30px;
  }

  @media (max-width: 991px) {
    .boku-learn-title { font-size: 2.2rem; }
    .boku-learn-header { flex-direction: column; align-items: flex-start; gap: 30px; }
    .boku-learn-nav { display: none; }
    .boku-learn-nav-bottom { display: flex; }
    .boku-learn-card { min-width: 280px; padding: 25px; }
  }
</style>

<div class="boku-learn-section">
  <div class="boku-learn-header">
    <div class="boku-learn-title-wrap">
      <h2 class="boku-learn-title">En savoir plus sur <span>Eumanic</span></h2>
      <p class="boku-learn-subtitle">Des histoires, des conseils et les dernières mises à jour sur l'EyeLuxe Pro et le monde de la beauté LED.</p>
    </div>
    <div class="boku-learn-nav">
      <button class="boku-learn-btn" onclick="slideLearn('left')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="boku-learn-btn" onclick="slideLearn('right')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>

  <div class="boku-learn-carousel" id="learnCarousel">
    
    <!-- CARD 1 -->
    <div class="boku-learn-card">
      <div>
        <h3 class="boku-learn-card-title">EyeLuxe Pro : bien plus qu'un accessoire beauté</h3>
        <p class="boku-learn-card-text">Découvrez comment la technologie NASA de photothérapie LED a révolutionné les soins du contour des yeux à domicile.</p>
      </div>
      <a href="/products/eyeluxe-pro" class="boku-learn-more-link">voir plus</a>
    </div>

    <!-- CARD 2 -->
    <div class="boku-learn-card">
      <div>
        <h3 class="boku-learn-card-title">Photothérapie : confort et science au service de votre regard</h3>
        <p class="boku-learn-card-text">Pourquoi intégrer la lumière rouge dans votre routine quotidienne peut transformer l'aspect de vos cernes en 10 minutes.</p>
      </div>
      <a href="/products/eyeluxe-pro" class="boku-learn-more-link">voir plus</a>
    </div>

    <!-- CARD 3 -->
    <div class="boku-learn-card">
      <div>
        <h3 class="boku-learn-card-title">Une révolution écologique et économique</h3>
        <p class="boku-learn-card-text">Dites adieu aux patchs jetables et aux crèmes hors de prix. L'EyeLuxe Pro est un investissement durable pour votre peau.</p>
      </div>
      <a href="/products/eyeluxe-pro" class="boku-learn-more-link">voir plus</a>
    </div>

    <!-- CARD 4 -->
    <div class="boku-learn-card">
      <div>
        <h3 class="boku-learn-card-title">Comment choisir son appareil LED contour des yeux ?</h3>
        <p class="boku-learn-card-text">Les critères essentiels à vérifier : longueur d'onde, certificats CE et ergonomie pour des résultats garantis.</p>
      </div>
      <a href="/products/eyeluxe-pro" class="boku-learn-more-link">voir plus</a>
    </div>

    <!-- CARD 5 -->
    <div class="boku-learn-card">
      <div>
        <h3 class="boku-learn-card-title">L'histoire de EUMANIC : redéfinir la beauté technologique</h3>
        <p class="boku-learn-card-text">Notre mission est d'apporter les traitements professionnels de clinique directement dans le confort de votre salle de bain.</p>
      </div>
      <a href="/products/eyeluxe-pro" class="boku-learn-more-link">voir plus</a>
    </div>

  </div>

  <div class="boku-learn-nav-bottom">
    <button class="boku-learn-btn" onclick="slideLearn('left')">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="boku-learn-btn" onclick="slideLearn('right')">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</div>

<script>
  function slideLearn(direction) {
    const carousel = document.getElementById('learnCarousel');
    const firstCard = carousel.querySelector('.boku-learn-card');
    const scrollAmount = firstCard ? firstCard.offsetWidth + 25 : 350;
    
    if (direction === 'left') {
      carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    } else {
      const maxScroll = carousel.scrollWidth - carousel.clientWidth;
      if (carousel.scrollLeft >= maxScroll - 5) {
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }
    }
  }
</script>

