<div id="omnilux-hero-{{ section.id }}" class="omnilux-hero-section">
  <div class="omnilux-hero__wrapper">
    
    <!-- Left Column: Image (Linked) -->
    <a href="/products/masseur-oculaire-intelligent" class="omnilux-hero__image-container">
      <img src="https://cdn.shopify.com/s/files/1/0986/3141/8238/files/product_page_acceuil.png?v=1771089157" 
           alt="EyeLuxe Pro - Masseur Oculaire Intelligent - Rajeunir mon regard"
           class="omnilux-hero__image"
           loading="eager"
           width="1000"
           height="1000">
    </a>
    
    <!-- Right Column: Content -->
    <div class="omnilux-hero__content">
      <span class="omnilux-hero__badge">
        ★★★★★ 150+ CLIENTS SATISFAITS
      </span>
      
      <h1 class="omnilux-hero__title">
        Régénérez votre regard<br>en 10 minutes par jour.
      </h1>
      
      <p class="omnilux-hero__subtitle">
        La seule technologie combinant <strong>Lumière Rouge 633nm</strong> + <strong>Stimulation EMS</strong> cliniquement prouvée pour éliminer cernes, poches et rides, à domicile.
      </p>
      
      <!-- CTA removed as requested -->

      <div class="omnilux-hero__features">
        <div class="omnilux-hero__feature">
          <span class="icon">✅</span> Efficacité Clinique
        </div>
        <div class="omnilux-hero__feature">
          <span class="icon">👨‍⚕️</span> Recommandé Experts
        </div>
        <div class="omnilux-hero__feature">
          <span class="icon">🛡️</span> 30 Jours d'Essai
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .omnilux-hero-section {
    width: 100%;
    background-color: #fafafa;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  .omnilux-hero__wrapper {
    display: flex;
    flex-direction: column; /* Mobile: Image top, Text bottom */
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    min-height: 85vh;
  }

  /* Desktop Layout */
  @media (min-width: 990px) {
    .omnilux-hero__wrapper {
      flex-direction: row; /* Image Left, Text Right naturally because of HTML order */
      justify-content: space-between;
      gap: 60px;
      padding: 0 5%;
    }

    .omnilux-hero__content {
      flex: 1;
      max-width: 600px;
      padding-top: 40px;
      padding-bottom: 40px;
      text-align: left;
    }

    .omnilux-hero__image-container {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100%;
      text-decoration: none; /* Remove underline from link wrapper */
      transition: transform 0.3s ease;
    }
    
    .omnilux-hero__image-container:hover {
      transform: scale(1.02); /* Subtle zoom effect on hover to indicate clickability */
    }
    
    .omnilux-hero__image {
      max-height: 85vh;
      width: auto;
      object-fit: contain;
    }
  }

  /* Mobile Layout */
  @media (max-width: 989px) {
    .omnilux-hero__wrapper {
      padding: 40px 20px;
      gap: 30px;
    }

    .omnilux-hero__content {
      text-align: center;
      width: 100%;
    }

    .omnilux-hero__image-container {
      width: 100%;
      text-decoration: none;
    }
    
    .omnilux-hero__image {
      width: 100%;
      height: auto;
      max-width: 500px;
    }
  }

  /* Typography & Elements */
  .omnilux-hero__badge {
    display: inline-block;
    color: #E63946;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    margin-bottom: 24px;
    text-transform: uppercase;
    background: rgba(230, 57, 70, 0.1);
    padding: 6px 12px;
    border-radius: 4px;
  }

  .omnilux-hero__title {
    font-size: clamp(2.5rem, 4vw, 3.8rem);
    font-weight: 900;
    line-height: 1.1;
    color: #111;
    margin: 0 0 24px 0;
    letter-spacing: -1px;
  }

  .omnilux-hero__subtitle {
    font-size: 1.15rem;
    color: #444;
    line-height: 1.6;
    margin: 0 0 40px 0;
    font-weight: 400;
  }

  .omnilux-hero__subtitle strong {
    color: #000;
    font-weight: 600;
  }

  /* Features Styling inspired by "Boku-Details" clean look */
  .omnilux-hero__features {
    display: flex;
    flex-direction: column; /* Stack vertically for varied look? Or stick to flex-wrap? User asked for "different details". Vertical list is cleaner like the reference section. */
    gap: 15px;
    margin-top: 30px;
    align-items: flex-start; /* Left align */
  }

  @media (max-width: 989px) {
    .omnilux-hero__features {
      align-items: center; /* Center on mobile */
    }
  }

  .omnilux-hero__feature {
    font-size: 1rem;
    font-weight: 500;
    color: #333;
    display: flex;
    align-items: center;
    gap: 12px;
    background: transparent;
    padding: 0;
    border: none;
    box-shadow: none;
  }

  .omnilux-hero__feature .icon {
    font-size: 1.2em;
    color: #E63946; /* Use brand color for icons */
  }
</style>

{% schema %}
{
  "name": "OMNILUX-HERO",
  "settings": [],
  "presets": [
    {
      "name": "OMNILUX-HERO"
    }
  ]
}
{% endschema %}
