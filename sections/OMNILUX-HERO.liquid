<div id="omnilux-hero-{{ section.id }}" class="omnilux-hero-section">
  <div class="omnilux-hero__wrapper">
    
    <!-- Left Column: Content -->
    <div class="omnilux-hero__content">
      <span class="omnilux-hero__badge">
        ★★★★★ 150+ CLIENTS SATISFAITS
      </span>
      
      <h1 class="omnilux-hero__title">
        Régénérez votre regard<br>en 10 minutes par jour.
      </h1>
      
      <p class="omnilux-hero__subtitle">
        La seule technologie combinant <strong>Lumière Rouge 633nm</strong> + <strong>Stimulation EMS</strong> cliniquement prouvée pour éliminer cernes, poches et rides, à domicile.
      </p>
      
      <a href="/products/masseur-oculaire-intelligent" class="omnilux-hero__cta">
        JE VEUX UN REGARD RADIEUX
      </a>

      <div class="omnilux-hero__features">
        <div class="omnilux-hero__feature">
          <span class="icon">✅</span> Efficacité Clinique
        </div>
        <div class="omnilux-hero__feature">
          <span class="icon">👨‍⚕️</span> Recommandé Experts
        </div>
        <div class="omnilux-hero__feature">
          <span class="icon">🛡️</span> 30 Jours d'Essai
        </div>
      </div>
    </div>

    <!-- Right Column: Image -->
    <div class="omnilux-hero__image-container">
      <img src="https://cdn.shopify.com/s/files/1/0986/3141/8238/files/product_page_acceuil.png?v=1771089157" 
           alt="EyeLuxe Pro - Masseur Oculaire Intelligent"
           class="omnilux-hero__image"
           loading="eager"
           width="1000"
           height="1000">
    </div>

  </div>
</div>

<style>
  .omnilux-hero-section {
    width: 100%;
    background-color: #fafafa; /* Très léger gris pour le contraste */
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  .omnilux-hero__wrapper {
    display: flex;
    flex-direction: column-reverse; /* Mobile: Image top, Text bottom if needed, or normal column */
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    min-height: 85vh; /* Hauteur viewport confortable */
  }

  /* Desktop Layout */
  @media (min-width: 990px) {
    .omnilux-hero__wrapper {
      flex-direction: row;
      justify-content: space-between;
      gap: 60px;
      padding: 0 5%;
    }

    .omnilux-hero__content {
      flex: 1;
      max-width: 600px;
      padding-top: 40px;
      padding-bottom: 40px;
      text-align: left;
    }

    .omnilux-hero__image-container {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100%;
    }
    
    .omnilux-hero__image {
      max-height: 85vh;
      width: auto;
      object-fit: contain;
    }
  }

  /* Mobile Layout */
  @media (max-width: 989px) {
    .omnilux-hero__wrapper {
      padding: 40px 20px;
      gap: 30px;
    }

    .omnilux-hero__content {
      text-align: center;
      width: 100%;
    }

    .omnilux-hero__image-container {
      width: 100%;
    }
    
    .omnilux-hero__image {
      width: 100%;
      height: auto;
      max-width: 500px; /* Limite la taille sur tablette */
    }
  }

  /* Typography & Elements */
  .omnilux-hero__badge {
    display: inline-block;
    color: #E63946;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    margin-bottom: 24px;
    text-transform: uppercase;
    background: rgba(230, 57, 70, 0.1);
    padding: 6px 12px;
    border-radius: 4px;
  }

  .omnilux-hero__title {
    font-size: clamp(2.5rem, 4vw, 3.8rem); /* Responsive font size */
    font-weight: 900;
    line-height: 1.1;
    color: #111;
    margin: 0 0 24px 0;
    letter-spacing: -1px;
  }

  .omnilux-hero__subtitle {
    font-size: 1.15rem;
    color: #444;
    line-height: 1.6;
    margin: 0 0 40px 0;
    font-weight: 400;
  }

  .omnilux-hero__subtitle strong {
    color: #000;
    font-weight: 600;
  }

  .omnilux-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #E63946;
    color: #ffffff;
    padding: 18px 45px;
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 50px; /* Pill shape for modern feel */
    box-shadow: 0 10px 25px rgba(230, 57, 70, 0.3);
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .omnilux-hero__cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(230, 57, 70, 0.4);
    background-color: #d62d3a;
  }

  .omnilux-hero__features {
    display: flex;
    gap: 20px;
    margin-top: 45px;
    flex-wrap: wrap;
    justify-content: flex-start; /* Desktop default */
  }

  @media (max-width: 989px) {
    .omnilux-hero__features {
      justify-content: center; /* Center on mobile */
    }
  }

  .omnilux-hero__feature {
    font-size: 0.85rem;
    font-weight: 600;
    color: #555;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    padding: 8px 14px;
    border-radius: 6px;
    border: 1px solid #eee;
    box-shadow: 0 2px 5px rgba(0,0,0,0.03);
  }

  .omnilux-hero__feature .icon {
    font-size: 1.1em;
  }
</style>

{% schema %}
{
  "name": "OMNILUX-HERO",
  "settings": [],
  "presets": [
    {
      "name": "OMNILUX-HERO"
    }
  ]
}
{% endschema %}
