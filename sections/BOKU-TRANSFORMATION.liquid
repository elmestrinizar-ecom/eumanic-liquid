<style>
  .boku-transformation-section {
    background: #ffffff;
    padding: 100px 20px;
    font-family: 'Inter', sans-serif;
    color: #1D3557;
    text-align: center;
  }
  .boku-transformation-container {
    max-width: 1000px;
    margin: 0 auto;
  }
  .boku-transformation-section h2 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 15px;
    line-height: 1.2;
  }
  .boku-transformation-section h2 em {
    font-style: italic;
    color: #E63946;
  }
  .boku-transformation-section h2 .highlight {
    text-decoration: underline;
    text-decoration-color: #E63946;
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }
  .boku-transformation-subtitle {
    font-size: 1.1rem;
    color: #666;
    margin-bottom: 60px;
  }

  /* Before/After Grid */
  .boku-transformation-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 50px;
    align-items: end;
  }
  @media (max-width: 768px) {
    .boku-transformation-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  .boku-transformation-item {
    position: relative;
  }
  .boku-transformation-image-wrapper {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    margin-bottom: 20px;
    background: #f5f5f5;
  }
  .boku-transformation-image {
    width: 100%;
    display: block;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  /* Timeline */
  .boku-transformation-timeline-wrapper {
    position: relative;
    margin-top: 30px;
  }
  .boku-transformation-timeline-line {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 3px;
    background: #E5E7EB;
    transform: translateY(-50%);
  }
  .boku-transformation-timeline-progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 50%;
    background: linear-gradient(90deg, #1D3557 0%, #E63946 100%);
  }
  .boku-transformation-timeline-dots {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .boku-transformation-timeline-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #E63946;
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(230, 57, 70, 0.3);
    position: relative;
    z-index: 2;
  }
  .boku-transformation-timeline-dot.inactive {
    background: #D1D5DB;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  /* Labels */
  .boku-transformation-label {
    margin-top: 15px;
    font-weight: 700;
    font-size: 1.1rem;
    color: #1D3557;
  }
  .boku-transformation-description {
    font-size: 0.95rem;
    color: #666;
    margin-top: 8px;
    line-height: 1.4;
  }

  /* CTA */
  .boku-transformation-cta {
    margin-top: 50px;
  }
  .boku-transformation-btn {
    display: inline-block;
    background: #E63946;
    color: #ffffff;
    padding: 18px 40px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    transition: all 0.3s ease;
    box-shadow: 0 10px 25px rgba(230, 57, 70, 0.2);
  }
  .boku-transformation-btn:hover {
    background: #cc333e;
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(230, 57, 70, 0.3);
  }
</style>

<div class="boku-transformation-section">
  <div class="boku-transformation-container">
    
    <h2>Retrouvez votre <em>meilleur vous-même</em> en seulement <span class="highlight">4 semaines.</span></h2>
    <p class="boku-transformation-subtitle">Des résultats visibles et durables, validés par des milliers d'utilisateurs.</p>

    <div class="boku-transformation-grid">
      
      <!-- Before -->
      <div class="boku-transformation-item">
        <div class="boku-transformation-image-wrapper">
          <img src="{{ 'transformation-before.png' | asset_url }}" alt="Avant EyeLuxe Pro" class="boku-transformation-image">
        </div>
        <div class="boku-transformation-label">Avant</div>
        <div class="boku-transformation-description">Cernes visibles et teint fatigué</div>
      </div>

      <!-- After -->
      <div class="boku-transformation-item">
        <div class="boku-transformation-image-wrapper">
          <img src="{{ 'transformation-after.png' | asset_url }}" alt="Après EyeLuxe Pro" class="boku-transformation-image">
        </div>
        <div class="boku-transformation-label">Après 4 semaines</div>
        <div class="boku-transformation-description">Regard frais et lumineux</div>
      </div>

    </div>

    <!-- Timeline -->
    <div class="boku-transformation-timeline-wrapper">
      <div class="boku-transformation-timeline-line">
        <div class="boku-transformation-timeline-progress"></div>
      </div>
      <div class="boku-transformation-timeline-dots">
        <div class="boku-transformation-timeline-dot"></div>
        <div class="boku-transformation-timeline-dot"></div>
      </div>
    </div>

    <!-- CTA -->
    <div class="boku-transformation-cta">
      <a href="/products/eyeluxe-pro" class="boku-transformation-btn">Commencer ma transformation →</a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "BOKU-TRANSFORMATION",
  "settings": [],
  "presets": [
    {
      "name": "BOKU-TRANSFORMATION"
    }
  ]
}
{% endschema %}
