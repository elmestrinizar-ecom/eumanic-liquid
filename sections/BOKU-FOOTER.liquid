{% comment %}
  Section: BOKU-FOOTER
  Footer Global Elite inspiré de Boku - Version Rouge Eumanic
{% endcomment %}

<style>
  .boku-footer {
    background-color: #E63946; /* Brand Red */
    color: #ffffff;
    padding: 80px 0 40px 0;
    font-family: 'Inter', sans-serif;
  }
  .boku-footer-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
    gap: 60px;
  }

  .boku-footer-col h3 {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 25px 0;
    color: #ffffff;
    text-transform: none;
  }
  
  .boku-footer-text {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.95;
    margin: 0;
  }

  .boku-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .boku-footer-links li {
    margin-bottom: 12px;
  }
  .boku-footer-links a {
    color: #ffffff;
    text-decoration: none;
    font-size: 1rem;
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }
  .boku-footer-links a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* Newsletter */
  .boku-footer-newsletter h3 {
    margin-bottom: 15px;
  }
  .boku-footer-newsletter p {
    font-size: 0.95rem;
    margin-bottom: 20px;
    opacity: 0.9;
  }
  .boku-footer-input-wrap {
    position: relative;
    max-width: 300px;
  }
  .boku-footer-input {
    width: 100%;
    background: #ffffff;
    border: none;
    padding: 15px 50px 15px 25px;
    border-radius: 100px;
    font-size: 0.95rem;
    outline: none;
    color: #1D3557;
  }
  .boku-footer-submit {
    position: absolute;
    right: 5px;
    top: 5px;
    bottom: 5px;
    width: 40px;
    background: #1D3557; /* Navy arrow box */
    border: none;
    border-radius: 50%;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.3s ease;
  }
  .boku-footer-submit:hover {
    transform: scale(1.1);
  }

  .boku-footer-social {
    display: flex;
    gap: 15px;
    margin-top: 25px;
  }
  .boku-footer-social-icon {
    width: 40px;
    height: 40px;
    background: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #E63946;
    text-decoration: none;
    transition: transform 0.3s ease;
  }
  .boku-footer-social-icon:hover {
    transform: translateY(-3px);
  }

  /* Bottom Area */
  .boku-footer-bottom {
    margin-top: 80px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }
  .boku-footer-logo-img {
    height: 80px; /* Increased size */
    width: auto;
    filter: none; /* Removing filter to show original logo colors */
  }
  .boku-footer-copyright {
    font-size: 0.9rem;
    opacity: 0.7;
    margin: 0;
  }


  @media (max-width: 991px) {
    .boku-footer-container {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .boku-footer-container {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .boku-footer-input-wrap {
      margin: 0 auto;
    }
    .boku-footer-social {
      justify-content: center;
    }
  }
</style>

<footer class="boku-footer">
  <div class="boku-footer-container">
    
    <!-- COL 1: About -->
    <div class="boku-footer-col">
      <h3>Qui sommes-nous?</h3>
      <p class="boku-footer-text">
        Une équipe de passionnés dédiée à révolutionner le soin du regard. Eumanic met toute son énergie au service de votre bien-être grâce à la technologie LED de pointe.
      </p>
    </div>

    <!-- COL 2: Info -->
    <div class="boku-footer-col">
      <h3>Pour les curieux</h3>
      <ul class="boku-footer-links">
        <li><a href="/pages/faq">FAQ</a></li>
        <li><a href="/pages/a-propos">À propos</a></li>
        <li><a href="/pages/contact">Nous contacter</a></li>
        <li><a href="/blogs/news">Blog</a></li>
        <li><a href="/pages/mentions-legales">Pages légales</a></li>
      </ul>
    </div>

    <!-- COL 3: Orders -->
    <div class="boku-footer-col">
      <h3>Commande</h3>
      <ul class="boku-footer-links">
        <li><a href="/pages/suivi-commande">Suivre ma commande</a></li>
        <li><a href="/pages/retours">Retours & Remboursements</a></li>
        <li><a href="/pages/garantie">Garantie 2 ans</a></li>
        <li><a href="/pages/ambassadeur">Devenir Ambassadeur</a></li>
      </ul>
    </div>

    <!-- COL 4: Newsletter -->
    <div class="boku-footer-col boku-footer-newsletter">
      <h3>On pense à votre regard</h3>
      <p>Un cadeau offert en vous inscrivant !</p>
      <div class="boku-footer-input-wrap">
        <input type="email" class="boku-footer-input" placeholder="Courriel">
        <button class="boku-footer-submit">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>
      </div>
      <div class="boku-footer-social">
        <a href="#" class="boku-footer-social-icon"><svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
        <a href="#" class="boku-footer-social-icon"><svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg></a>
        <a href="#" class="boku-footer-social-icon"><svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
      </div>
    </div>

  </div>

  <div class="boku-footer-bottom">
    <img src="https://cdn.shopify.com/s/files/1/0986/3141/8238/files/Design_sans_titre__1_-removebg-preview_e6711c4a-b940-4fd3-8559-7a68877ac2d9.png?v=1770487198" class="boku-footer-logo-img" alt="Eumanic Logo">
    
    <p class="boku-footer-copyright">
      © {{ 'now' | date: '%Y' }} EUMANIC - Tous droits réservés.
    </p>


  </div>
</footer>

