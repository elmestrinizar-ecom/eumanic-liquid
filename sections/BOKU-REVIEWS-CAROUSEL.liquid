  </div>
</div>

<script>
  // Optional: Automatic scroll behavior
  (function() {
    const track = document.getElementById('bokuReviewsTrack');
    let scrollAmount = 0;
    const scrollStep = 1;
    let isHovered = false;

    track.addEventListener('mouseenter', () => isHovered = true);
    track.addEventListener('mouseleave', () => isHovered = false);

    function autoScroll() {
      if (!isHovered) {
        track.scrollLeft += scrollStep;
        if (track.scrollLeft >= (track.scrollWidth - track.clientWidth)) {
          track.scrollLeft = 0;
        }
      }
      requestAnimationFrame(autoScroll);
    }
    // Uncomment the next line to enable continuous auto-scroll
    // autoScroll();
  })();
</script>

