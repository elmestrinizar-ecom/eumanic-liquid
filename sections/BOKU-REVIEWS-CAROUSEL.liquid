<style>
  .boku-reviews-carousel-section {
    background: #FFFAFA; /* Soft pinkish white like Sinezy */
    padding: 80px 20px;
    font-family: 'Inter', sans-serif;
    color: #1D3557;
    text-align: center;
  }
  .boku-reviews-header {
    margin-bottom: 50px;
  }
  .boku-reviews-trust-top {
    color: #E63946; /* Red for trust */
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 5px;
    display: block;
  }
  .boku-reviews-stars-top {
    color: #E63946;
    font-size: 1.2rem;
    margin-bottom: 15px;
    display: block;
  }
  .boku-reviews-carousel-section h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0;
  }

  /* Carousel Container */
  .boku-reviews-carousel-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    padding: 20px 0;
  }
  .boku-reviews-track {
    display: flex;
    gap: 25px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE and Edge */
    padding-bottom: 20px;
    scroll-behavior: smooth;
  }
  .boku-reviews-track::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }

  /* Review Card */
  .boku-review-card {
    background: #ffffff;
    min-width: 320px;
    width: 320px;
    border-radius: 20px;
    overflow: hidden;
    scroll-snap-align: start;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    text-align: left;
    transition: transform 0.3s ease;
  }
  @media (max-width: 768px) {
    .boku-review-card { min-width: 280px; width: 280px; }
  }

  .boku-review-img-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .boku-review-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .boku-review-content {
    padding: 25px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .boku-review-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #444;
    margin-bottom: 20px;
    flex-grow: 1;
  }
  .boku-review-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #f2f2f2;
    padding-top: 15px;
  }
  .boku-review-stars {
    color: #E63946;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .boku-review-verified {
    font-size: 0.75rem;
    font-weight: 700;
    color: #1D3557;
    background: #f1f1f1;
    padding: 3px 10px;
    border-radius: 5px;
  }
  .boku-review-author {
    margin-top: 10px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #1D3557;
  }

  /* Progress/Nav Dots */
  .boku-reviews-nav {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 30px;
  }
  .boku-reviews-arrow {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #eee;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
  }
  .boku-reviews-arrow:hover {
    background: #1D3557;
    color: #fff;
    border-color: #1D3557;
  }
  .boku-reviews-arrow svg {
    width: 18px;
    height: auto;
  }
</style>

