<style>
  .boku-benefits-section {
    padding: 80px 20px;
    background: #ffffff;
    font-family: 'Inter', sans-serif;
  }
  .boku-benefits-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  @media (max-width: 991px) {
    .boku-benefits-container {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 40px 0;
    }
    .boku-benefits-section { padding: 40px 20px; }
  }

  .boku-benefits-image-wrapper {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  }
  .boku-benefits-image {
    width: 100%;
    display: block;
    transition: transform 0.5s ease;
  }
  .boku-benefits-image-wrapper:hover .boku-benefits-image {
    transform: scale(1.03);
  }
  .boku-benefits-label {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: rgba(255,255,255,0.9);
    padding: 10px 20px;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: #1D3557;
    backdrop-filter: blur(5px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }
  .boku-benefits-label svg {
    width: 30px;
    height: auto;
  }

  /* Content Styling */
  .boku-benefits-content h2 {
    font-size: 5rem;
    font-weight: 800;
    color: #1D3557;
    margin: 0 0 10px 0;
    line-height: 1;
  }
  .boku-benefits-subtitle {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1D3557;
    margin-bottom: 20px;
  }
  .boku-benefits-description {
    font-size: 1rem;
    line-height: 1.6;
    color: #444;
    margin-bottom: 30px;
  }
  .boku-benefits-description strong {
    color: #1D3557;
  }

  /* Accordions */
  .boku-benefits-accordion {
    border-top: 1px solid #f0f0f0;
  }
  .boku-benefits-item {
    border-bottom: 1px solid #f0f0f0;
  }
  .boku-benefits-item summary {
    list-style: none;
    padding: 20px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 700;
    font-size: 1.1rem;
    color: #1D3557;
  }
  .boku-benefits-item summary::-webkit-details-marker { display: none; }
  .boku-benefits-item summary::after {
    content: '+';
    font-size: 1.5rem;
    font-weight: 300;
    transition: transform 0.3s ease;
  }
  .boku-benefits-item[open] summary::after {
    transform: rotate(45deg);
  }
  .boku-benefits-details {
    padding-bottom: 20px;
    font-size: 0.95rem;
    color: #666;
    line-height: 1.6;
  }

  /* Trust Badges */
  .boku-benefits-badges {
    display: flex;
    gap: 20px;
    margin-top: 40px;
  }
  .boku-badge-card {
    display: flex;
    align-items: center;
    gap: 15px;
    background: #f8f9fa;
    padding: 12px 20px;
    border-radius: 12px;
    border: 1px solid #eee;
    flex: 1;
  }
  .boku-badge-icon {
    width: 32px;
    height: 32px;
    background: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.7rem;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    color: #1D3557;
  }
  .boku-badge-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: #1D3557;
    line-height: 1.2;
  }
  .boku-badge-text span {
    display: block;
    color: #999;
    font-weight: 400;
    font-size: 0.65rem;
  }
</style>

<div class="boku-benefits-section">
  <div class="boku-benefits-container">
    
    <!-- Left: Image (Sinezy vibe) -->
    <div class="boku-benefits-image-wrapper">
      <img src="{{ 'eyeluxe-pro-hero.jpg' | asset_url }}" alt="EyeLuxe Pro en action" class="boku-benefits-image">
      <div class="boku-benefits-label">
        <svg viewBox="0 0 100 20" preserveAspectRatio="none"><path d="M0 10 Q 25 20 50 10 T 100 10" fill="none" stroke="#E63946" stroke-width="2"></path></svg>
        <span>Photobiomodulation oculaire</span>
      </div>
    </div>

    <!-- Right: Content (Sinezy content) -->
    <div class="boku-benefits-content">
      <h2>93%</h2>
      <p class="boku-benefits-subtitle">Des utilisateurs soulagés en moins de 7 jours</p>
      
      <p class="boku-benefits-description">
        La <strong>lumière rouge</strong> et les micro-vibrations agissent naturellement pour stimuler la micro-circulation, réduire l'inflammation et lisser le regard. <br><br>
        Validé par des études cliniques, <strong>EyeLuxe Pro</strong> agit en profondeur sur les couches cutanées, sans effets secondaires ni dépendance.
      </p>

      <div class="boku-benefits-accordion">
        <details class="boku-benefits-item">
          <summary>✓ Cernes & Poches sous les yeux</summary>
          <div class="boku-benefits-details">
            Réduit visiblement le volume des poches et éclaircit les cernes en boostant le drainage lymphatique.
          </div>
        </details>
        
        <details class="boku-benefits-item">
          <summary>✓ Rides & Pattes d'oie</summary>
          <div class="boku-benefits-details">
            Stimule la production naturelle de collagène et d'élastine pour combler les ridules de l'intérieur.
          </div>
        </details>

        <details class="boku-benefits-item">
          <summary>✓ Fatigue Oculaire & Tensions</summary>
          <div class="boku-benefits-details">
            Apaise les yeux fatigués par les écrans grâce à une chaleur apaisante et un massage relaxant.
          </div>
        </details>

        <details class="boku-benefits-item">
          <summary>✓ Éclat & Jeunesse du regard</summary>
          <div class="boku-benefits-details">
            Unifie le teint du contour de l'œil pour un regard plus frais, reposé et pétillant de vitalité.
          </div>
        </details>
      </div>

      <div class="boku-benefits-badges">
        <div class="boku-badge-card">
          <div class="boku-badge-icon">MED</div>
          <div class="boku-badge-text">MEDICAL <span>Grade médical certifié</span></div>
        </div>
        <div class="boku-badge-card">
          <div class="boku-badge-icon">ISO</div>
          <div class="boku-badge-text">ISO 13485 <span>Certifié Haute Qualité</span></div>
        </div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "BOKU-PRODUCT-BENEFITS",
  "settings": [],
  "presets": [
    {
      "name": "BOKU-PRODUCT-BENEFITS"
    }
  ]
}
{% endschema %}
