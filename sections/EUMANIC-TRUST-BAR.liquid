{% comment %}
  Section: EUMANIC-TRUST-BAR
  Barre de réassurance Elite - Style CurrentBody
  Fond Rouge, Texte Blanc, 5 Items spécifiques
{% endcomment %}

<style>
  .eumanic-trust-bar {
    background: #E63946; /* Brand Red */
    padding: 20px 0;
    overflow: hidden;
    font-family: 'Inter', sans-serif;
    border-top: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  
  .eumanic-trust-marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 60px;
  }
  
  .eumanic-trust-track {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 60px;
    min-width: 100%;
    animation: eumanic-scroll-elite 35s linear infinite;
  }
  
  @keyframes eumanic-scroll-elite {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - 60px)); }
  }

  .eumanic-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  
  .eumanic-trust-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
  }
  
  .eumanic-trust-icon svg {
    width: 22px;
    height: 22px;
    stroke-width: 1.5px;
  }
  
  .eumanic-trust-text {
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    white-space: nowrap;
  }

  /* Pause on hover */
  .eumanic-trust-marquee:hover .eumanic-trust-track {
    animation-play-state: paused;
  }

  @media (max-width: 768px) {
    .eumanic-trust-bar { padding: 15px 0; }
    .eumanic-trust-track { gap: 40px; animation-duration: 25s; }
    .eumanic-trust-icon { width: 36px; height: 36px; }
    .eumanic-trust-icon svg { width: 18px; height: 18px; }
    .eumanic-trust-text { font-size: 0.6rem; letter-spacing: 0.5px; }
  }
</style>

