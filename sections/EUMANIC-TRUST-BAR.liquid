{% comment %}
  Section: EUMANIC-TRUST-BAR
  Barre de réassurance inspirée de CurrentBody avec défilement infini
{% endcomment %}

<style>
  .eumanic-trust-bar {
    background: #ffffff;
    border-bottom: 1px solid #eeeeee;
    padding: 25px 0;
    overflow: hidden;
    font-family: 'Inter', sans-serif;
  }
  
  .eumanic-trust-marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 50px;
  }
  
  .eumanic-trust-track {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 50px;
    min-width: 100%;
    animation: eumanic-scroll 40s linear infinite;
  }
  
  @keyframes eumanic-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - 50px)); }
  }

  .eumanic-trust-item {
    display: flex;
    align-items: center;
    gap: 15px;
    flex-shrink: 0;
  }
  
  .eumanic-trust-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid #1D3557; /* Navy */
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1D3557;
    flex-shrink: 0;
  }
  
  .eumanic-trust-icon svg {
    width: 24px;
    height: 24px;
  }
  
  .eumanic-trust-text {
    color: #1D3557;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  /* Pause on hover */
  .eumanic-trust-marquee:hover .eumanic-trust-track {
    animation-play-state: paused;
  }

  @media (max-width: 768px) {
    .eumanic-trust-bar { padding: 20px 0; }
    .eumanic-trust-track { gap: 30px; animation-duration: 25s; }
    .eumanic-trust-icon { width: 40px; height: 40px; }
    .eumanic-trust-icon svg { width: 20px; height: 20px; }
    .eumanic-trust-text { font-size: 0.65rem; }
  }
</style>

